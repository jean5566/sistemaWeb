# Copia este archivo como .env y completa los valores reales
# NUNCA subas el archivo .env a git

VITE_API_URL=https://tu-dominio.com/api

# URL del frontend (usada por el backend para CORS)
# En producción: https://www.tu-dominio.com
# En desarrollo local: http://localhost:5173
FRONTEND_URL=https://www.tu-dominio.com

# JWT Secret (OBLIGATORIO): genera una cadena aleatoria segura de al menos 64 caracteres
# Puedes generarla con: openssl rand -hex 64
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_SEGURA_DE_64_CARACTERES_MINIMO

# SRI Configuration
SRI_ENV=1  # 1: Pruebas, 2: Producción
SRI_RUC=TU_RUC_AQUI
SRI_FIRMA_PATH=/home/tu_usuario/firma.p12
SRI_FIRMA_PASS=tu_contraseña_firma

# Database (solo para Docker local, en cPanel se configura en config.php)
DB_HOST=localhost
DB_NAME=nombre_bd
DB_USER=usuario_bd
DB_PASS=contraseña_bd
